# What the Linux app is built on, and tried on with no screen: Ubuntu 22.04, for its
# older glibc, the oldest with WebKitGTK 4.1 (https://v2.tauri.app/distribute/appimage/).
FROM docker.io/library/ubuntu:22.04
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
    curl ca-certificates build-essential pkg-config file libwebkit2gtk-4.1-dev libssl-dev libgtk-3-dev \
    libayatana-appindicator3-dev librsvg2-dev libxdo-dev xdg-utils xvfb dbus-x11 imagemagick x11-apps
ENV CARGO_HOME=/cargo RUSTUP_HOME=/cargo/rustup PATH=/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
