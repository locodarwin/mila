{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mila",
  "version": "0.0.0",
  "identifier": "com.locodarwin.mila",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "externalBin": ["binaries/mila"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "Productivity",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 locodarwin",
    "shortDescription": "Mila, your project manager",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
