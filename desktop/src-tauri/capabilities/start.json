{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "start",
  "description": "The app's own Places screen, which chooses and keeps the places work lives in.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-places-list",
    "allow-place-status",
    "allow-connect-server",
    "allow-cancel-connect",
    "allow-add-local",
    "allow-open-place",
    "allow-rename-place",
    "allow-sign-out-place",
    "allow-forget-place",
    "allow-show-folder",
    "allow-set-open-last"
  ]
}
