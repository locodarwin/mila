		{ "name": "week: across a leap day", "task": { "dueDate": "2028-03-03" }, "context": { "today": "2028-02-25" }, "filter": { "due": "week" }, "want": true },
		{ "name": "week: across a leap day, a day too far", "task": { "dueDate": "2028-03-04" }, "context": { "today": "2028-02-25" }, "filter": { "due": "week" }, "want": false },
		{ "name": "week: no date is not", "task": { "dueDate": null }, "filter": { "due": "week" }, "want": false },
		{ "name": "none: no date", "task": { "dueDate": null }, "filter": { "due": "none" }, "want": true },
		{ "name": "none: a date is not", "filter": { "due": "none" }, "want": false },
		{ "name": "an unknown due choice matches nothing", "filter": { "due": "someday" }, "want": false },
		{ "name": "text in the title, any case", "filter": { "text": "FENCE" }, "want": true },
		{ "name": "text in the notes", "filter": { "text": "grey" }, "want": true },
		{ "name": "text nowhere", "filter": { "text": "roof" }, "want": false },
		{ "name": "text is trimmed", "filter": { "text": "  paint the  " }, "want": true },
		{ "name": "only spaces is no text", "filter": { "text": "   " }, "want": true },
		{ "name": "a byte order mark is trimmed", "filter": { "text": "﻿fence" }, "want": true },
		{ "name": "a next-line character is not trimmed", "filter": { "text": "\u0085fence" }, "want": false },
		{ "name": "a no-break space is trimmed", "filter": { "text": " fence　" }, "want": true },
		{ "name": "text across title and notes", "filter": { "text": "fence\nuse" }, "want": true },
		{ "name": "text needs the line break between title and notes", "filter": { "text": "fence use" }, "want": false },
		{ "name": "accented text", "task": { "title": "CAFÉ order" }, "filter": { "text": "café" }, "want": true },
