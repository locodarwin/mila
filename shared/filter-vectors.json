{
	"_comment": "Saved-view filter cases checked by both web/src/lib/filter.ts and server/internal/filter. Each match case starts from the defaults and replaces the task and context fields it names. category is the status category the task's status has; statusId is the task's status itself, or null for none. fieldTypes are the custom fields the viewer knows, by ID; values are the task's stored values by field ID. blocked and blocking say whether the task waits for one not done, and whether it holds one up. inMyDay says whether the viewer picked it for My Day, today or earlier. A task's estimateMinutes is its own estimate; entries are the time logged on it (user, day and minutes, 0 for a timer still running). A match case gives a filter, or a config (a saved view's whole config) to read the filter out of. A part of the wrong JSON type, and a filter or a config that is not an object, match nothing; null leaves a part, or the whole filter, unset.",
	"defaults": {
		"task": {
			"id": "t1",
			"projectId": "p1",
			"statusId": "s1",
			"title": "Paint the fence",
			"notes": "Use the grey paint",
			"priority": "high",
			"dueDate": "2026-10-28"
		},
		"context": {
			"me": "u1",
			"today": "2026-10-28",
			"category": "todo",
			"labels": ["l1"],
			"assignees": ["u1"],
			"fieldTypes": { "f-text": "text", "f-url": "url", "f-num": "number", "f-date": "date", "f-sel": "select", "f-multi": "multi_select", "f-check": "checkbox", "f-user": "user" },
			"values": { "f-text": "Call the Supplier", "f-url": "https://example.com/Seeds", "f-num": 12.5, "f-date": "2026-11-02", "f-sel": "o1", "f-multi": ["o1", "o2"], "f-check": true, "f-user": "u1" }
		}
	},
	"matches": [
		{ "name": "an empty filter shows an open task", "filter": {}, "want": true },
		{ "name": "nulls are unset parts", "filter": { "text": null, "projects": null, "statuses": null, "due": null, "showDone": null }, "want": true },
		{ "name": "a finished task is hidden", "context": { "category": "done" }, "filter": {}, "want": false },
		{ "name": "a canceled task is hidden", "context": { "category": "canceled" }, "filter": {}, "want": false },
		{ "name": "showDone shows a finished task", "context": { "category": "done" }, "filter": { "showDone": true }, "want": true },
		{ "name": "asking for done shows a finished task", "context": { "category": "done" }, "filter": { "statuses": ["done"] }, "want": true },
		{ "name": "asking for canceled shows a done task too, then the status part decides", "context": { "category": "done" }, "filter": { "statuses": ["canceled"] }, "want": false },
		{ "name": "asking for canceled shows a canceled task", "context": { "category": "canceled" }, "filter": { "statuses": ["todo", "canceled"] }, "want": true },
		{ "name": "a status picked by ID keeps a task in it", "filter": { "statusIds": ["s1"] }, "want": true },
		{ "name": "a status picked by ID leaves out a task in another", "filter": { "statusIds": ["s2"] }, "want": false },
		{ "name": "a status by ID or a category: the status is enough", "filter": { "statuses": ["backlog"], "statusIds": ["s1"] }, "want": true },
		{ "name": "a status by ID or a category: the category is enough", "filter": { "statuses": ["todo"], "statusIds": ["s2"] }, "want": true },
		{ "name": "a status by ID or a category: neither", "filter": { "statuses": ["backlog"], "statusIds": ["s2"] }, "want": false },
		{ "name": "a finished status picked shows a finished task in it", "context": { "category": "done" }, "filter": { "statusIds": ["s1"] }, "want": true },
		{ "name": "a finished task in a status not picked stays hidden", "context": { "category": "done" }, "filter": { "statusIds": ["s2"] }, "want": false },
		{ "name": "a finished status picked beside an open category", "context": { "category": "canceled" }, "filter": { "statuses": ["todo"], "statusIds": ["s1"] }, "want": true },
		{ "name": "a task with no status matches no status picked by ID", "task": { "statusId": null }, "filter": { "statusIds": [""] }, "want": false },
		{ "name": "no statuses picked by ID leaves the part unset", "filter": { "statusIds": [] }, "want": true },
		{ "name": "statusIds that is not a list matches nothing", "filter": { "statusIds": "s1" }, "want": false },
		{ "name": "statusIds holding a number matches nothing", "filter": { "statusIds": [1] }, "want": false },
		{ "name": "statusIds read out of a config", "config": { "filter": { "statusIds": ["s1"] } }, "want": true },
		{ "name": "the status part matches any choice", "filter": { "statuses": ["backlog", "todo"] }, "want": true },
		{ "name": "the status part refuses others", "filter": { "statuses": ["in-progress"] }, "want": false },
		{ "name": "an empty status list is unset", "context": { "category": "done" }, "filter": { "statuses": [] }, "want": false },
		{ "name": "a project choice", "filter": { "projects": ["p2", "p1"] }, "want": true },
		{ "name": "another project", "filter": { "projects": ["p2"] }, "want": false },
		{ "name": "the inbox is a project", "task": { "projectId": null }, "filter": { "projects": ["inbox"] }, "want": true },
		{ "name": "a project task is not in the inbox", "filter": { "projects": ["inbox"] }, "want": false },
		{ "name": "an inbox task is in no named project", "task": { "projectId": null }, "filter": { "projects": ["p1"] }, "want": false },
		{ "name": "a priority choice", "filter": { "priorities": ["urgent", "high"] }, "want": true },
		{ "name": "another priority", "filter": { "priorities": ["low"] }, "want": false },
		{ "name": "no priority is a priority", "task": { "priority": "none" }, "filter": { "priorities": ["none"] }, "want": true },
		{ "name": "a task in my My Day is in it", "context": { "inMyDay": true }, "filter": { "myDay": true }, "want": true },
		{ "name": "a task not in my My Day is not", "filter": { "myDay": true }, "want": false },
		{ "name": "myDay false is no filter", "filter": { "myDay": false }, "want": true },
		{ "name": "myDay that is not true or false matches nothing", "context": { "inMyDay": true }, "filter": { "myDay": "yes" }, "want": false },
		{ "name": "a done task in My Day is hidden", "context": { "inMyDay": true, "category": "done" }, "filter": { "myDay": true }, "want": false },
		{ "name": "a task with a due date is dated", "filter": { "due": "dated" }, "want": true },
		{ "name": "a task with no due date is not dated", "task": { "dueDate": null }, "filter": { "due": "dated" }, "want": false },
		{ "name": "a task due long after today is dated", "task": { "dueDate": "2027-06-01" }, "filter": { "due": "dated" }, "want": true },
		{ "name": "a task that waits is blocked", "context": { "blocked": true }, "filter": { "dependencies": ["blocked"] }, "want": true },
		{ "name": "a task that waits for nothing is not blocked", "filter": { "dependencies": ["blocked"] }, "want": false },
		{ "name": "a task holding one up is blocking", "context": { "blocking": true }, "filter": { "dependencies": ["blocking"] }, "want": true },
		{ "name": "a blocked task is not blocking", "context": { "blocked": true }, "filter": { "dependencies": ["blocking"] }, "want": false },
		{ "name": "either dependency matches", "context": { "blocking": true }, "filter": { "dependencies": ["blocked", "blocking"] }, "want": true },
		{ "name": "an unknown dependency matches nothing", "context": { "blocked": true }, "filter": { "dependencies": ["waiting"] }, "want": false },
		{ "name": "no dependencies asked for is no filter", "filter": { "dependencies": [] }, "want": true },
		{ "name": "dependencies that are not a list match nothing", "context": { "blocked": true }, "filter": { "dependencies": "blocked" }, "want": false },
		{ "name": "a done task that waited is hidden", "context": { "blocked": true, "category": "done" }, "filter": { "dependencies": ["blocked"] }, "want": false },
		{ "name": "a task with an estimate is estimated", "task": { "estimateMinutes": 60 }, "filter": { "time": ["estimated"] }, "want": true },
		{ "name": "a task with no estimate is not estimated", "filter": { "time": ["estimated"] }, "want": false },
		{ "name": "a task with no estimate is unestimated", "filter": { "time": ["unestimated"] }, "want": true },
		{ "name": "an estimate of zero is still an estimate", "task": { "estimateMinutes": 0 }, "filter": { "time": ["unestimated"] }, "want": false },
		{ "name": "more logged than the estimate is over", "task": { "estimateMinutes": 60 }, "context": { "entries": [{ "user": "u2", "day": "2026-10-27", "minutes": 45 }, { "user": "u1", "day": "2026-10-28", "minutes": 30 }] }, "filter": { "time": ["over"] }, "want": true },
		{ "name": "exactly the estimate logged is not over", "task": { "estimateMinutes": 75 }, "context": { "entries": [{ "user": "u2", "day": "2026-10-27", "minutes": 45 }, { "user": "u1", "day": "2026-10-28", "minutes": 30 }] }, "filter": { "time": ["over"] }, "want": false },
		{ "name": "time logged with no estimate is never over", "context": { "entries": [{ "user": "u1", "day": "2026-10-28", "minutes": 300 }] }, "filter": { "time": ["over"] }, "want": false },
		{ "name": "time logged six days ago is recent", "context": { "entries": [{ "user": "u2", "day": "2026-10-22", "minutes": 30 }] }, "filter": { "time": ["recent"] }, "want": true },
		{ "name": "time logged seven days ago is not recent", "context": { "entries": [{ "user": "u2", "day": "2026-10-21", "minutes": 30 }] }, "filter": { "time": ["recent"] }, "want": false },
		{ "name": "time logged for a later day is not recent", "context": { "entries": [{ "user": "u2", "day": "2026-10-29", "minutes": 30 }] }, "filter": { "time": ["recent"] }, "want": false },
		{ "name": "a timer running today is recent", "context": { "entries": [{ "user": "u2", "day": "2026-10-28", "minutes": 0 }] }, "filter": { "time": ["recent"] }, "want": true },
		{ "name": "a task with none logged is not recent", "filter": { "time": ["recent"] }, "want": false },
		{ "name": "time the viewer logged is mine", "context": { "entries": [{ "user": "u2", "day": "2026-10-01", "minutes": 30 }, { "user": "u1", "day": "2026-09-01", "minutes": 5 }] }, "filter": { "time": ["mine"] }, "want": true },
		{ "name": "time only others logged is not mine", "context": { "entries": [{ "user": "u2", "day": "2026-10-01", "minutes": 30 }] }, "filter": { "time": ["mine"] }, "want": false },
		{ "name": "every time condition must hold", "task": { "estimateMinutes": 60 }, "context": { "entries": [{ "user": "u2", "day": "2026-10-28", "minutes": 30 }] }, "filter": { "time": ["estimated", "mine"] }, "want": false },
		{ "name": "time conditions that all hold match", "task": { "estimateMinutes": 20 }, "context": { "entries": [{ "user": "u1", "day": "2026-10-28", "minutes": 30 }] }, "filter": { "time": ["estimated", "over", "recent", "mine"] }, "want": true },
		{ "name": "an unknown time condition matches nothing", "task": { "estimateMinutes": 60 }, "filter": { "time": ["estimated", "soon"] }, "want": false },
		{ "name": "time that is not a list matches nothing", "task": { "estimateMinutes": 60 }, "filter": { "time": "estimated" }, "want": false },
		{ "name": "an empty time list is unset", "filter": { "time": [] }, "want": true },
		{ "name": "any label", "filter": { "labels": ["l2", "l1"] }, "want": true },
		{ "name": "another label", "filter": { "labels": ["l2"] }, "want": false },
		{ "name": "no labels on the task", "context": { "labels": [] }, "filter": { "labels": ["l1"] }, "want": false },
		{ "name": "every part must match", "filter": { "priorities": ["high"], "labels": ["l2"] }, "want": false },
		{ "name": "every part matches", "filter": { "priorities": ["high"], "labels": ["l1"], "projects": ["p1"], "assignees": ["me"], "due": "today", "text": "fence" }, "want": true },
		{ "name": "me is whoever is looking", "filter": { "assignees": ["me"] }, "want": true },
		{ "name": "me for someone else", "context": { "me": "u2" }, "filter": { "assignees": ["me"] }, "want": false },
		{ "name": "a person by ID", "context": { "assignees": ["u1", "u3"] }, "filter": { "assignees": ["u3"] }, "want": true },
		{ "name": "a person who is not assigned", "filter": { "assignees": ["u3"] }, "want": false },
		{ "name": "nobody assigned", "context": { "assignees": [] }, "filter": { "assignees": ["me", "u3"] }, "want": false },
		{ "name": "overdue: yesterday", "task": { "dueDate": "2026-10-27" }, "filter": { "due": "overdue" }, "want": true },
