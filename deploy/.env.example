# The domain or subdomain Mila answers on. Point its DNS at this server.
MILA_DOMAIN=mila.example.com

# Email for sign-in links and invitations, such as
# smtp://user:password@smtp.example.com:587. Leave empty and links are
# written to the server log instead (docker compose logs mila).
MILA_SMTP_URL=
MILA_MAIL_FROM=Mila <mila@mila.example.com>

# Leave empty for SQLite in the mila-data volume.
MILA_DATABASE_URL=

# Only used with --profile postgres: a long random one, such as the
# output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# on lets apps that sign in by OAuth, such as hosted assistants, connect
# to the agents' tools once a person says yes. See docs/agents.md.
MILA_OAUTH=off
