{
	"name": "mila-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/fonts.mjs && node scripts/diagram-chunks.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"generate": "npx --yes -p openapi-typescript@7.13.0 -p typescript@5.9.3 openapi-typescript ../shared/openapi.yaml -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts && npx --yes -p openapi-typescript@7.13.0 -p typescript@5.9.3 js-yaml ../shared/openapi.yaml > ../server/internal/httpapi/openapi.json",
		"budget:size": "node scripts/size-budget.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"axe-core": "^4.14.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@lucide/svelte": "^1.63.0",
		"@simplewebauthn/browser": "^14.0.0",
		"@tiptap/core": "^3.32.1",
		"@tiptap/extension-code-block-lowlight": "^3.32.1",
		"@tiptap/extension-collaboration": "^3.32.1",
		"@tiptap/extension-collaboration-caret": "^3.32.1",
		"@tiptap/extension-image": "^3.32.1",
		"@tiptap/extension-list": "^3.32.1",
		"@tiptap/extension-paragraph": "^3.32.1",
		"@tiptap/extension-table": "^3.32.1",
		"@tiptap/extensions": "^3.32.1",
		"@tiptap/markdown": "^3.32.1",
		"@tiptap/pm": "^3.32.1",
		"@tiptap/starter-kit": "^3.32.1",
		"@tiptap/y-tiptap": "^3.0.12",
		"dexie": "^4.4.7",
		"lowlight": "^3.3.0",
		"mermaid": "^12.3.0",
		"openapi-fetch": "^0.17.0",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.33"
	}
}
